<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required to send Apple Events to browsers once the app is signed with
         the Hardened Runtime. Harmless before then. Note this is NOT the
         sandbox temporary-exception variant: the app is not sandboxed, and
         cannot be, because the Accessibility API is unavailable inside the
         sandbox. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
